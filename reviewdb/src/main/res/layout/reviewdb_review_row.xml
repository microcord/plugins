<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:background="@drawable/reviewdb_vote_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <com.discord.views.PluginAvatarView
        android:id="@+id/reviewdb_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/reviewdb_avatar_background"
        android:contentDescription="Reviewer avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reviewdb_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB9BBBE"
            android:textSize="11sp" />

        <com.discord.utilities.view.text.SimpleDraweeSpanTextView
            android:id="@+id/reviewdb_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/reviewdb_upvote"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Upvote review"
            android:src="@drawable/ic_reviewdb_up" />

        <TextView
            android:id="@+id/reviewdb_score"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/reviewdb_downvote"
            android:layout_width="28dp"
            android:layout_height="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Downvote review"
            android:src="@drawable/ic_reviewdb_down" />
    </LinearLayout>
</LinearLayout>
